<%- include('partials/head', { pageTitle: item ? t('edit') : t('newListing') }) %>
<section class="wrap section narrow">
  <h1 class="page-h"><%= item ? t('edit') : t('newListing') %></h1>
  <p class="muted"><%= t('moderationNote') %></p>
  <% if (error) { %><div class="err"><%= t(error) %></div><% } %>
  <form class="panel" method="post" enctype="multipart/form-data" action="<%= item ? '/dashboard/edit/' + item._id : '/dashboard/new' %>">
    <label><%= t('title') %><input name="title" required minlength="3" maxlength="120" value="<%= form.title || '' %>"></label>
    <label><%= t('description') %><textarea name="description" rows="6" required minlength="10" maxlength="5000"><%= form.description || '' %></textarea></label>
    <div class="row2">
      <label><%= t('price') %><input type="number" name="price" required min="0" max="100000000" step="0.01" value="<%= form.price ?? '' %>"></label>
      <label><%= t('currency') %><select name="currency"><% ['USD','EUR','MXN','DOP','HTG','CAD'].forEach(function(c){ %><option <%= form.currency===c?'selected':'' %>><%= c %></option><% }) %></select></label>
    </div>
    <div class="row2">
      <label><%= t('category') %><select name="category" required><option value=""></option><% CATEGORIES.forEach(function(c){ %><option value="<%= c.slug %>" <%= form.category===c.slug?'selected':'' %>><%= c.name[lang] %></option><% }) %></select></label>
      <label><%= t('stock') %><input type="number" name="stock" min="0" max="100000" value="<%= form.stock ?? 1 %>"></label>
    </div>
    <div class="row2">
      <label><%= t('condition') %><select name="condition"><% ['new','used','refurbished'].forEach(function(c){ %><option value="<%= c %>" <%= form.condition===c?'selected':'' %>><%= t(c) %></option><% }) %></select></label>
      <label><%= t('status') %><select name="status"><option value="active" <%= form.status!=='paused'?'selected':'' %>><%= t('active') %></option><option value="paused" <%= form.status==='paused'?'selected':'' %>><%= t('paused') %></option></select></label>
    </div>
    <% if (item && item.images && item.images.length) { %>
      <div class="lbl"><%= t('keepPhotos') %></div>
      <div class="photo-keep"><% item.images.forEach(function(id){ %><label><img src="/img/<%= id %>" alt=""><input type="checkbox" name="removeImages" value="<%= id %>"></label><% }) %></div>
    <% } %>
    <label><%= t('photos') %><input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple id="photoInput"><small class="muted"><%= t('photosHint') %></small></label>
    <div class="photo-preview" id="photoPreview"></div>
    <div class="form-actions"><a class="btn btn-ghost" href="/dashboard"><%= t('cancel') %></a><button class="btn btn-gold"><%= t('save') %></button></div>
  </form>
</section>
<%- include('partials/foot') %>
